{
  "accent": "#6d5dfc",
  "allow_local_streams": false,
  "always_on_top": false,
  "autoplay_next_delay_s": 10,
  "compact": false,
  "convert_output_dir": null,
  "convert_overwrite": "rename",
  "convert_parallel": 1,
  "convert_template": "{name}",
  "crossfade_ms": 0,
  "default_volume": 80,
  "extensions": [
    "mp4",
    "mkv",
    "avi",
    "mov",
    "webm",
    "mpg",
    "mpeg",
    "ts",
    "m2ts",
    "wmv",
    "flv",
    "ogv",
    "m4v",
    "mp3",
    "aac",
    "flac",
    "wav",
    "alac",
    "ogg",
    "opus",
    "wma",
    "aiff",
    "aif",
    "m4a"
  ],
  "hw_decoding": "auto",
  "language": "nl",
  "network_caching_ms": 1500,
  "normalize_realtime": false,
  "online_metadata": false,
  "online_subtitle_search": false,
  "periodic_scan_minutes": null,
  "preferred_audio_languages": [
    "nld",
    "eng"
  ],
  "preferred_subtitle_languages": [
    "nld"
  ],
  "resume_playback": true,
  "scan_on_startup": false,
  "seek_long_s": 30,
  "seek_short_s": 5,
  "shortcuts": {
    "ab_loop": "Shift+L",
    "audio_delay_down": "J",
    "audio_delay_up": "K",
    "chapter_next": "Ctrl+ArrowRight",
    "chapter_previous": "Ctrl+ArrowLeft",
    "cycle_audio": "B",
    "cycle_subtitles": "V",
    "frame_step": "E",
    "fullscreen": "F",
    "go_to_time": "Ctrl+T",
    "mini_player": "Ctrl+M",
    "mute": "M",
    "next": "N",
    "open_file": "Ctrl+O",
    "open_playlist": "Ctrl+L",
    "open_settings": "Ctrl+,",
    "play_pause": "Space",
    "previous": "P",
    "screenshot": "Shift+S",
    "seek_back": "ArrowLeft",
    "seek_back_long": "Shift+ArrowLeft",
    "seek_forward": "ArrowRight",
    "seek_forward_long": "Shift+ArrowRight",
    "speed_down": "[",
    "speed_reset": "=",
    "speed_up": "]",
    "stop": "S",
    "subtitle_delay_down": "G",
    "subtitle_delay_up": "H",
    "toggle_playlist": "Ctrl+P",
    "volume_down": "ArrowDown",
    "volume_up": "ArrowUp"
  },
  "subtitle_color": "#ffffff",
  "subtitle_encoding": "",
  "subtitle_scale": 1.0,
  "theme": "dark",
  "ui_scale": 1.0
}
