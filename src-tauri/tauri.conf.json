{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VLC Ultimate",
  "version": "0.1.0",
  "identifier": "nl.vlcultimate.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VLC Ultimate",
        "width": 1280,
        "height": 760,
        "minWidth": 720,
        "minHeight": 440,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/nl.vlcultimate.studio/cache/thumbnails/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "copyright": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": { "../resources/vlc/": "vlc/", "../resources/ffmpeg/": "ffmpeg/" },
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh",
        "installMode": "both",
        "languages": ["Dutch", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
